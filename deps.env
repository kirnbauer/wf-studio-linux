# Pinned third-party components bundled with wf-studio-linux (all freely redistributable).
# Every download is verified against the sha256 below by scripts/fetch-deps.sh.
# Watch Face Studio itself is NOT listed here: it is downloaded by the user at first start.

# Electron runtime - must match the Electron version WFS was built with
# (WatchFaceStudio.exe 1.9.9 reports Electron/31.3.1).
ELECTRON_VERSION=31.3.1
ELECTRON_URL=https://github.com/electron/electron/releases/download/v31.3.1/electron-v31.3.1-linux-x64.zip
ELECTRON_SHA256=951ffd460ae1b1543c8fa0c76587eb72977612316a61a2b42fe311999444a65a

# Android SDK Build-Tools (aapt, aapt2, zipalign, apksigner) - WFS targets android-34
BUILD_TOOLS_URL=https://dl.google.com/android/repository/build-tools_r34-linux.zip
BUILD_TOOLS_SHA256=e858c4b60069d0431051b225d384413b1643e1289b00a4825aed347f25bd510f

# Android SDK Platform-Tools (adb)
PLATFORM_TOOLS_URL=https://dl.google.com/android/repository/platform-tools_r35.0.2-linux.zip
PLATFORM_TOOLS_SHA256=acfdcccb123a8718c46c46c059b2f621140194e5ec1ac9d81715be3d6ab6cd0a

# JDK 21 (WFS ships Oracle JDK 21 on Windows; Eclipse Temurin is the drop-in replacement)
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz
JDK_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c

# 7-Zip (unpacks Samsung's NSIS installer at first start)
SEVENZIP_URL=https://github.com/ip7z/7zip/releases/download/24.08/7z2408-linux-x64.tar.xz
SEVENZIP_SHA256=9b3a2edf0644a2b00b0a39ab6843f426128e4a6f6f98c40f8c02a668e5b5b59b

# AppImage tooling (build time only)
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.0/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=46fdd785094c7f6e545b61afcfb0f3d98d8eab243f644b4b17698c01d06083d1
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
